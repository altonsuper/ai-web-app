# Server secret — NEVER commit. Set the same values in Vercel Project Settings > Environment Variables.
HF_TOKEN=hf_paste_server_token_here
SESSION_SECRET=change_me_to_32_random_chars
# Default brains (HF serverless = free compute, PC stays cool)
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Text-to-image provider on the HF router (nscale proxies an OpenAI-style image API; fal-ai is the fallback)
HF_IMAGE_PROVIDER=nscale
HF_TTS_MODEL=hexgrad/Kokoro-82M
HF_STT_MODEL=openai/whisper-large-v3
